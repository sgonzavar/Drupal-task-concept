<?php
/**
 * @file
 * Funciones procedurales y Hooks para el módulo Weather Sync.
 */

/**
 * Implements hook_cron().
 *
 * Este hook se dispara cuando corre el cron del sistema.
 * Usamos la State API para asegurar que nuestra lógica pesada
 * solo corra cada 5 horas.
 */

function weather_sync_cron() {
  // Servicio State API para almacenar y recuperar datos volátiles del entorno.
  $state = \Drupal::state();

  // Timestamp normalizado de la solicitud actual de Drupal (sustituye a time()).
  $time = \Drupal::time()->getRequestTime();

  // Timestamp de la última sincronización. Por defecto 0 si nunca ha corrido.
  $last_run = $state->get('weather_sync.last_city_sync', 0);

  //intervalo: 5 horas
  //En dev puede bajarlo a otro valor, 60 para probar: $interval = 60;
  $interval = (int) \Drupal::config('weather_sync.settings')->get('cron_interval') ?? 180000;

  // Evita la ejecución innecesaria si no ha transcurrido la ventana de tiempo.
  if (($time - $last_run) >= $interval) {
    try {

      //Ciudades objetivo: configurable via config + fallback hardcoded
      $config_cities = \Drupal::config('weather_sync.settings')->get('target_cities');
      $target_cities = $config_cities ?: [
        ['name' => 'Bogota,CO'],
        ['name' => 'Medellin,CO'],
        ['name' => 'Cali,CO'],
        ['name' => 'Barranquilla,CO'],
        ['name' => 'Cartagena,CO'],
        ['name' => 'Bucaramanga,CO'],
        ['name' => 'Pereira,CO'],
      ];

      // Obtenemos la cola de procesamiento en segundo plano.
      $queue = \Drupal::queue('weather_sync_city_queue');
      $endqueue = 0;

      foreach ($target_cities as $city_data) {
        //validacion basica
        if(!empty($city_data['name'])) {
          $queue->createItem($city_data);
          $endqueue++;
        }
      }

      $state->set('weather_sync.last_city_sync', $time);

      \Drupal::logger('weather_sync')->notice(
        'Cron ejecutado: @count ciudades encoladas para taxonomía weather_city.',
        ['@count' => $endqueue]
      );
    }
    catch (\Exception $e) {
      // Captura excepciones de red o servicio para evitar que el cron general falle.
      \Drupal::logger('weather_sync')->error(
        'Error durante la sincronización en cron: @message',
        ['@message' => $e->getMessage()]
      );
    }
  }
}
